---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageTransition from "../components/magicui/PageTransition.tsx";
import AboutPage from "../components/routes/AboutView.tsx";

export const prerender = true;
---

<BaseLayout>
  <head slot="head">
    <title>About – Gedion T.</title>
    <meta
      name="description"
      content="About Gedion T, frontend engineer and creative developer."
    />
  </head>

  <PageTransition client:load>
    <AboutPage client:visible />
  </PageTransition>
</BaseLayout>
