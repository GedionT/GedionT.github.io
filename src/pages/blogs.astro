---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageTransition from "../components/PageTransition.tsx";
import BlogsPage from "../components/routes/BlogsView.tsx";

export const prerender = true;
---

<BaseLayout>
  <head slot="head">
    <title>Blog - Gedion T.</title>
    <meta
      name="description"
      content="Thoughts on frontend, design, and engineering."
    />
  </head>

  <PageTransition client:load>
    <BlogsPage client:visible />
  </PageTransition>
</BaseLayout>
